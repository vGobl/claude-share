{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "types": ["node", "bun"],
    "paths": {
      "@shared/*": ["./shared/*"],
    },
  },
  "include": ["claude-share", "claude-connect", "shared", "scripts", "tests"],
}
