# Disable TUNNELING in development
TUNNEL=0

# Enable Development only features
NODE_ENV=development

# use this port (Optional)
PORT=2589

# Bore server for tunneling TCP (Optional)
BORE_SERVER=bore.pub

# Bore server password (Optional)
BORE_PASSWORD=

# Additional approved HTTPS passthrough domains (Optional, exact names only)
# These never receive the sharer's OAuth token.
PASSTHROUGH_DOMAINS=
